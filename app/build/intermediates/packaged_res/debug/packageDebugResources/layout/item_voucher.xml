<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Pink Ticket Badge -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:background="@color/soft_pink"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:contentDescription="Voucher icon"
                android:src="@drawable/ic_ticket"
                app:tint="@color/primary_pink" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="COUPON"
                android:textColor="@color/primary_pink"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/border_grey" />

        <!-- Voucher Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvVoucherTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giảm 50.000đ"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVoucherDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Đơn từ 150.000đ • Tất cả nhà hàng"
                android:textColor="@color/text_medium"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvVoucherExpiryCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_soft_pink_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="HSD: 20/10/2025 • Mã: FOODNOW50"
                android:textColor="@color/primary_pink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Apply Button -->
        <Button
            android:id="@+id/btnUseVoucher"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="12dp"
            android:backgroundTint="@color/primary_pink"
            android:paddingHorizontal="12dp"
            android:text="Áp dụng"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="18dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
